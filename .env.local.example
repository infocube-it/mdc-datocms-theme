# Copy to .env.local and fill in with tokens from the DatoCMS test project
# (Project settings → API tokens). Never commit .env.local.

# Read-only Content Delivery API token for published content.
DATOCMS_PUBLISHED_CONTENT_CDA_TOKEN=
# Content Management API token with schema write access, for migrations.
DATOCMS_CMA_TOKEN=
# Secret that protects draft mode and the preview links. Any long random
# string, e.g. `openssl rand -hex 24`.
DRAFT_MODE_SECRET=
# The Site's public URL on Netlify, without a path (e.g.
# https://my-site.netlify.app). `npm run test:e2e:deploy` tests it.
DEPLOY_URL=
# Secret that protects the cache invalidation endpoints. Any long random
# string, e.g. `openssl rand -hex 24`. Set it in DatoCMS' webhook and in
# Netlify's deploy notification too.
CACHE_WEBHOOK_SECRET=
# Optional: the DatoCMS environment to read (a sandbox's ID). Unset reads
# primary. Netlify deploy contexts set it in netlify.toml.
DATOCMS_ENVIRONMENT=
# Only for a Site in `granular` invalidation mode: the Turso database that
# holds the query index (`libsql://…`) and a read-write token for it.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
