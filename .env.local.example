# Copy to .env.local and fill in with tokens from the DatoCMS test project
# (Project settings → API tokens). Never commit .env.local.

# Read-only Content Delivery API token for published content.
DATOCMS_PUBLISHED_CONTENT_CDA_TOKEN=
# Content Management API token with schema write access, for migrations.
DATOCMS_CMA_TOKEN=
# Secret that protects draft mode and the preview links. Any long random
# string, e.g. `openssl rand -hex 24`.
DRAFT_MODE_SECRET=
