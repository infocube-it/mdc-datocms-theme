# Copy of this file: ~/.claude/devcontainer.env on the host, outside the
# repository and readable only by you. host-init.sh creates it on the first run.
# The container gets these as environment variables (docker --env-file: no
# quotes, no spaces around '=').

# Claude Code login: the token from 'claude setup-token' on the host.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional: a read-only GitHub token, so the agent can read CI runs, logs and
# artifacts with gh. Fine-grained, this repository only, Actions: Read and
# nothing else. See README.md, "First start".
# GH_TOKEN=

# Your git identity for commits made in the container, where .git/config is
# read-only. Uncomment and fill in.
# GIT_AUTHOR_NAME=Your Name
# GIT_AUTHOR_EMAIL=you@example.com
# GIT_COMMITTER_NAME=Your Name
# GIT_COMMITTER_EMAIL=you@example.com
