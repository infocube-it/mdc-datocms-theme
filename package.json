{
  "name": "mdc-datocms-seed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:deploy": "dotenv -c -- bash -c 'BASE_URL=\"${DEPLOY_URL:?Set DEPLOY_URL in .env.local}\" playwright test'",
    "generate-schema": "dotenv -c -- bash -c 'gql.tada generate schema https://graphql.datocms.com --header \"X-Exclude-Invalid: true\" --header \"Authorization: $DATOCMS_PUBLISHED_CONTENT_CDA_TOKEN\" && gql.tada generate output'",
    "migrations:new": "dotenv -c -- bash -c 'datocms migrations:new --ts --api-token=\"$DATOCMS_CMA_TOKEN\" \"$@\"' --",
    "migrations:run": "dotenv -c -- bash -c 'datocms migrations:run --api-token=\"$DATOCMS_CMA_TOKEN\" \"$@\"' --"
  },
  "dependencies": {
    "@datocms/cda-client": "^0.3.2",
    "@libsql/client": "^0.18.0",
    "@netlify/functions": "^6.0.2",
    "gql.tada": "^1.11.4",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-datocms": "^8.1.2",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@datocms/cma-client-node": "^6.1.3",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "datocms": "^4.2.0",
    "dotenv-cli": "^11.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
